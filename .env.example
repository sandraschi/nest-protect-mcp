# Nest Protect MCP — environment template (no real secrets here).
# Copy to .env and fill in:  Copy-Item .env.example .env
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_PROJECT_ID=
NEST_REFRESH_TOKEN=
# Optional
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio
MCP_PORT=10753
# Optional CORS extras (comma-separated origins, e.g. LAN dashboard)
CORS_ALLOW_ORIGINS=
WIZARD_FRONTEND_ORIGIN=
